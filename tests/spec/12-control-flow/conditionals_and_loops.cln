start:
	integer a = 2
	integer count = 0
	integer total = 0
	list<integer> items = [1, 2, 3]
	if a > 1
		return
	else if a == 0
		count = 1
	else
		count = 2
	iterate item in items
		total = total + item
	iterate i in 1 to 10 step 2
		if i == 5
			break
		continue
	iterate r in 10 to 1 step -2
		total = total + r
	while count < 10
		count = count + 1
