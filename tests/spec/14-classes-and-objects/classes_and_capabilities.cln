class Canvas
	integer width

class Point
	integer x
	integer y = 0

	always:
		x >= 0

	constructor(integer startX)
		x = startX

	constructor()
		x = 0

	functions:
		integer sum()
			return x + y
		void draw(Canvas target)
			return
		number area()
			return 0.0
		string describe()
			return "point"

class Point3 is Point can Draw, Serialize
	integer z

can Draw:
	draw(Canvas target) -> void
	area() -> number

can Serialize:
	describe() -> string
